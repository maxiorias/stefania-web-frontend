---
// Íconos SVG inline (reemplazan a Font Awesome por CDN)
interface Props {
  nombre: 'email' | 'instagram' | 'linkedin' | 'pdf' | 'descarga' | 'whatsapp' | 'menu' | 'cerrar';
  class?: string;
}
const { nombre, class: clase = 'size-5' } = Astro.props;
---

<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>)}
  {nombre === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5v.01" /></>)}
  {nombre === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></>)}
  {nombre === 'pdf' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></>)}
  {nombre === 'descarga' && (<><path d="M12 4v11M7 10l5 5 5-5" /><path d="M5 20h14" /></>)}
  {nombre === 'whatsapp' && (<><path d="M3 21l1.7-4.7A8.5 8.5 0 1 1 8 19.6z" /><path d="M9 9.5c.3 1.8 2 3.6 3.8 4.2l1.2-1.1 2 1-.4 1.4c-3 .4-7-3.3-7-6.6l1.4-.5 1 2z" /></>)}
  {nombre === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
