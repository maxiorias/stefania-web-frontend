---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Contacto from '../components/Contacto.astro';
import Icono from '../components/Icono.astro';
import fotoStefania from '../assets/foto-stefania.jpg';
import { persona, trayectoria, servicios } from '../data/sitio';

const anio = new Date().getFullYear();
const enlaceFooter = 'text-crema/70 transition-colors hover:text-white';

const credenciales = [
  { valor: '2018', texto: 'Licenciatura en Psicopedagogía' },
  { valor: '2023', texto: 'Maestría en Derechos Humanos' },
  { valor: persona.matricula, texto: 'Matrícula profesional' },
  { valor: 'Trelew', texto: 'Chubut, Argentina' },
];
---

<Layout>
  <Nav />

  <main>
    <!-- Inicio -->
    <section id="inicio" class="relative overflow-hidden px-4 pt-32 pb-16 sm:px-6 md:pt-40 md:pb-24">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[32rem] rounded-full bg-arena/30 blur-3xl" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-[1.15fr_1fr]">
        <div class="text-center md:text-left">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/70 px-4 py-1.5 text-xs font-semibold tracking-widest text-cafe uppercase ring-1 ring-cafe/15">
            <span class="size-1.5 rounded-full bg-cafe"></span>
            Mgtr. Lic. en Psicopedagogía
          </p>
          <h1 class="mt-6 font-serif text-[2.6rem] leading-[1.05] sm:text-6xl tracking-tight text-tinta lg:text-7xl">
            Stefania del Valle <em class="text-cafe">Alberti</em>
          </h1>
          {persona.bajada.map((linea) => <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-texto md:mx-0">{linea}</p>)}
          <div class="mt-9 flex flex-wrap justify-center gap-3 md:justify-start">
            <a href="#contacto" class="rounded-full bg-cafe px-7 py-3.5 font-semibold text-white shadow-lg shadow-cafe/25 transition hover:-translate-y-0.5 hover:bg-cafe-oscuro">
              Hacer una consulta
            </a>
            <a href="#servicios" class="rounded-full bg-white/70 px-7 py-3.5 font-semibold text-cafe ring-1 ring-cafe/25 transition hover:bg-white">
              Ver servicios
            </a>
          </div>
        </div>

        <!-- Retrato en arco: el fondo cálido detrás y el tinte crema integran el gris frío de la foto -->
        <div class="relative mx-auto w-full max-w-[17rem] sm:max-w-[22rem]">
          <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-t-full sm:translate-x-4 sm:translate-y-4 rounded-b-[2rem] bg-cafe/80" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-t-full rounded-b-[2rem] bg-arena shadow-2xl">
            <Image
              src={fotoStefania}
              alt={`Lic. ${persona.nombre}`}
              width={440}
              densities={[1, 2]}
              loading="eager"
              class="aspect-[4/5] w-full object-cover object-[center_20%]"
            />
            <div class="absolute inset-0 bg-crema mix-blend-multiply" aria-hidden="true"></div>
          </div>
          <div class="absolute -bottom-5 -left-6 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-xl sm:-left-10">
            <span class="grid size-10 place-items-center rounded-full bg-crema font-serif text-lg text-cafe">DH</span>
            <span class="text-left text-sm leading-tight">
              <strong class="block text-tinta">Magíster en DD.HH.</strong>
              <span class="text-texto">Niñez, adolescencia y familia</span>
            </span>
          </div>
        </div>
      </div>

      <dl class="relative mx-auto mt-24 grid max-w-6xl grid-cols-2 gap-px overflow-hidden rounded-3xl bg-cafe/10 ring-1 ring-cafe/10 md:grid-cols-4">
        {credenciales.map((c) => (
          <div class="bg-white/60 px-5 py-6 text-center backdrop-blur">
            <dt class="font-serif text-2xl text-cafe sm:text-3xl">{c.valor}</dt>
            <dd class="mt-1 text-sm text-texto">{c.texto}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Sobre mí: línea de tiempo -->
    <section id="sobre-mi" class="bg-crema-claro px-4 py-24 sm:px-6">
      <div class="mx-auto max-w-2xl text-center" data-revelar>
        <p class="text-xs font-semibold tracking-widest text-cafe uppercase">Trayectoria</p>
        <h2 class="mt-3 font-serif text-4xl text-tinta sm:text-5xl">Sobre mí</h2>
      </div>

      <ol class="relative mx-auto mt-16 max-w-5xl space-y-14 before:absolute before:top-2 before:bottom-2 before:left-4 before:w-px before:bg-cafe/20 md:space-y-20 md:before:left-1/2">
        {trayectoria.map((t, i) => (
          <li class="relative grid items-center gap-6 pl-12 md:grid-cols-2 md:gap-16 md:pl-0" data-revelar>
            <span class="absolute top-2 left-4 size-3 -translate-x-1/2 rounded-full bg-cafe ring-4 ring-crema-claro md:top-1/2 md:left-1/2 md:-translate-y-1/2" aria-hidden="true"></span>
            <div class={i % 2 ? 'md:order-2' : ''}>
              <Image
                src={t.foto}
                alt={t.alt}
                width={720}
                class="aspect-[4/3] w-full rounded-3xl object-cover shadow-lg"
                style={`object-position: ${t.posicion ?? 'center'}`}
              />
            </div>
            <div class={i % 2 ? 'md:order-1 md:text-right' : ''}>
              <span class="inline-block rounded-full bg-crema px-3 py-1 text-xs font-semibold tracking-wide text-cafe ring-1 ring-cafe/15">
                {t.anio ?? t.etiqueta}
              </span>
              <h3 class="mt-3 font-serif text-2xl leading-snug text-tinta sm:text-3xl">{t.titulo}</h3>
              <p class="mt-3 leading-relaxed text-texto">{t.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="px-4 py-24 sm:px-6">
      <div class="mx-auto max-w-2xl text-center" data-revelar>
        <p class="text-xs font-semibold tracking-widest text-cafe uppercase">Qué hago</p>
        <h2 class="mt-3 font-serif text-4xl text-tinta sm:text-5xl">Servicios</h2>
      </div>
      <div class="mx-auto mt-14 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {servicios.map((s, i) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-cafe/10 transition duration-300 hover:-translate-y-1 hover:shadow-xl" data-revelar>
            <div class="overflow-hidden">
              <Image src={s.foto} alt={s.titulo} width={600} class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <span class="font-serif text-sm text-cafe/70">0{i + 1}</span>
              <h3 class="mt-1 font-serif text-xl leading-snug text-tinta">{s.titulo}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-texto">{s.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Contacto />
  </main>

  <footer class="bg-tinta px-4 pt-14 pb-8 text-crema sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-10 text-center md:grid-cols-3 md:text-left">
      <div class="space-y-1.5 text-crema/70">
        <p class="font-serif text-xl text-white">{persona.nombre}</p>
        <p>Psicopedagoga · Matrícula {persona.matricula}</p>
        <p>{persona.ubicacion}</p>
      </div>

      <div>
        <h4 class="mb-3 text-xs font-semibold tracking-widest text-arena uppercase">Enlaces</h4>
        <div class="flex flex-col gap-2">
          <a href="#servicios" class={enlaceFooter}>Servicios</a>
          <a href={persona.linkedin} target="_blank" rel="noopener" class={enlaceFooter}>Perfil profesional (LinkedIn)</a>
          <a href={`mailto:${persona.email}`} class={enlaceFooter}>Consultas por email</a>
        </div>
      </div>

      <div>
        <h4 class="mb-3 text-xs font-semibold tracking-widest text-arena uppercase">Seguime</h4>
        <div class="flex justify-center gap-3 md:justify-start">
          <a href={persona.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-11 place-items-center rounded-full bg-white/10 text-crema transition hover:bg-cafe">
            <Icono nombre="linkedin" class="size-5" />
          </a>
          {persona.whatsapp && (
            <a href={`https://wa.me/${persona.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid size-11 place-items-center rounded-full bg-white/10 text-crema transition hover:bg-cafe">
              <Icono nombre="whatsapp" class="size-5" />
            </a>
          )}
        </div>
      </div>
    </div>
    <p class="mx-auto mt-12 max-w-6xl border-t border-white/10 pt-6 text-center text-sm text-crema/50">
      &copy; {anio} {persona.nombre}. Todos los derechos reservados.
    </p>
  </footer>
</Layout>
