---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Contacto from '../components/Contacto.astro';
import Icono from '../components/Icono.astro';
import Perfil from '../components/Perfil.astro';
import fotoStefania from '../assets/foto-stefania.jpg';
import { persona, enlaceWhatsapp, evaluaciones, proceso, servicios, otrosServicios, trayectoria, preguntas, coberturas, otrasCoberturas } from '../data/sitio';

const esquemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};

const anio = new Date().getFullYear();
const enlaceFooter = 'text-crema/70 transition-colors hover:text-white';

// Ficha como la cabecera de un protocolo de evaluación
const ficha = [
  { campo: 'Experiencia', valor: '+8 años', detalle: 'en neurorehabilitación' },
  { campo: 'Formación', valor: 'Magíster', detalle: 'UNSAM · tesis publicada' },
  { campo: 'Atención', valor: 'Trelew', detalle: 'y Puerto Madryn los jueves' },
  { campo: 'Matrícula', valor: persona.matriculas[0].numero, detalle: persona.matriculas[0].provincia },
];

// Alturas (px) de cada paso sobre la línea de perfil de "Cómo trabajo"
const pasosY = [72, 30, 56];

const titulo = 'mx-auto max-w-2xl text-center';
const antetitulo = 'text-xs font-semibold tracking-widest text-cafe uppercase';
const h2 = 'mt-3 font-serif text-4xl text-tinta sm:text-5xl';
---

<Layout esquemas={[esquemaFaq]}>
  <Nav />

  <main>
    <!-- Inicio -->
    <section id="inicio" class="relative overflow-hidden px-4 pt-32 pb-16 sm:px-6 md:pt-40 md:pb-20">
      <div class="relative mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-[1.15fr_1fr]">
        <div class="text-center md:text-left">
          <p class="inline-flex items-center gap-3 text-sm font-medium text-cafe">
            <span class="h-px w-10 bg-cafe/50" aria-hidden="true"></span>
            Psicopedagoga · Trelew y Puerto Madryn
          </p>
          <h1 class="mt-6 font-serif text-[2.4rem] leading-[1.08] tracking-tight text-tinta sm:text-6xl">
            Evaluación psicopedagógica con abordaje
            <span class="relative inline-block whitespace-nowrap">
              neurocognitivo
              <!-- Subrayado a mano -->
              <svg class="absolute -bottom-2 left-0 h-4 w-full overflow-visible sm:-bottom-3" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
                <path d="M4 10 C 60 4, 140 3, 296 7 M 30 13 C 110 9, 190 10, 260 12" fill="none" class="trazo stroke-cafe" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style="--largo: 700; --demora: .9s" />
              </svg>
            </span>
          </h1>
          <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-texto md:mx-0">{persona.presentacion}</p>
          <div class="mt-9 flex flex-wrap justify-center gap-3 md:justify-start">
            {enlaceWhatsapp ? (
              <a href={enlaceWhatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-cafe px-7 py-3.5 font-semibold text-white shadow-lg shadow-cafe/25 transition hover:-translate-y-0.5 hover:bg-cafe-oscuro">
                <Icono nombre="whatsapp" class="size-5" /> Consultar por WhatsApp
              </a>
            ) : (
              <a href="#contacto" class="rounded-full bg-cafe px-7 py-3.5 font-semibold text-white shadow-lg shadow-cafe/25 transition hover:bg-cafe-oscuro">Hacer una consulta</a>
            )}
            <a href="#evaluaciones" class="rounded-full px-7 py-3.5 font-semibold text-cafe ring-1 ring-cafe/30 transition hover:bg-white/60">
              Ver evaluaciones
            </a>
          </div>
          <!-- Nota a mano -->
          <p class="mt-4 flex items-start justify-center gap-1 font-mano text-2xl text-cafe md:justify-start md:pl-6" aria-hidden="true">
            <svg class="mt-1 h-8 w-9 shrink-0" viewBox="0 0 36 32" fill="none">
              <path d="M30 28 C 18 26, 8 20, 7 5 M 2 11 L 7 4 L 12 10" class="stroke-cafe" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="-rotate-2">contame qué venís notando</span>
          </p>
        </div>

        <!-- Retrato con epígrafe, como una lámina -->
        <figure class="mx-auto w-full max-w-[17rem] sm:max-w-[22rem]">
          <div class="relative overflow-hidden rounded-[2rem] bg-arena shadow-2xl shadow-cafe/20 ring-1 ring-cafe/15">
            <Image
              src={fotoStefania}
              alt={`Lic. ${persona.nombre}`}
              width={440}
              densities={[1, 2]}
              loading="eager"
              class="aspect-[4/5] w-full object-cover object-[center_20%]"
            />
            <div class="absolute inset-0 bg-crema mix-blend-multiply" aria-hidden="true"></div>
          </div>
          <figcaption class="mt-4 flex items-baseline justify-between gap-4 px-1">
            <span class="font-mano text-3xl leading-none text-tinta">Stefania</span>
            <span class="text-right text-xs font-semibold tracking-widest text-cafe uppercase">Mgtr. Lic. en Psicopedagogía</span>
          </figcaption>
        </figure>
      </div>

      <!-- Perfil de evaluación: atraviesa el inicio por detrás de la ficha -->
      <Perfil class="pointer-events-none relative mx-auto mt-16 block w-full max-w-6xl opacity-80 md:-mb-10" />

      <dl class="relative mx-auto grid max-w-6xl grid-cols-2 border-y-2 border-cafe/30 bg-crema/80 backdrop-blur-sm md:grid-cols-4">
        {ficha.map((f, i) => (
          <div class={`px-4 py-5 sm:px-6 ${i % 2 ? 'border-l border-cafe/20' : ''} ${i >= 2 ? 'border-t border-cafe/20 md:border-t-0' : ''} ${i === 2 ? 'md:border-l' : ''}`}>
            <dt class="text-[11px] font-semibold tracking-widest text-cafe/80 uppercase">{f.campo}</dt>
            <dd class="mt-1.5">
              <span class="font-serif text-2xl text-tinta sm:text-3xl">{f.valor}</span>
              <span class="mt-0.5 block text-sm text-texto">{f.detalle}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Evaluaciones -->
    <section id="evaluaciones" class="bg-white px-4 py-24 sm:px-6">
      <div class="mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-32" data-revelar>
          <p class={antetitulo}>Evaluaciones</p>
          <h2 class={h2}>Conocer el perfil para acompañar mejor</h2>
          <p class="mt-5 text-lg leading-relaxed text-texto">{evaluaciones.intro}</p>
          <Image src={evaluaciones.foto} alt="Evaluación neurocognitiva" width={640} class="mt-8 aspect-[4/3] w-full rounded-3xl object-cover shadow-lg" />
        </div>

        <div class="space-y-5">
          {evaluaciones.items.map((e, i) => (
            <article class="rounded-3xl bg-crema-claro p-7 ring-1 ring-cafe/10 sm:p-8" data-revelar>
              <span class="font-serif text-sm text-cafe/70">0{i + 1}</span>
              <h3 class="mt-1 font-serif text-2xl text-tinta">{e.titulo}</h3>
              <p class="mt-3 leading-relaxed text-texto">{e.texto}</p>
            </article>
          ))}
          <blockquote class="rounded-3xl bg-cafe p-7 font-serif text-xl leading-snug text-white sm:p-8 sm:text-2xl" data-revelar>
            “{evaluaciones.cita}”
          </blockquote>
        </div>
      </div>
    </section>

    <!-- Proceso -->
    <section id="proceso" class="px-4 py-24 sm:px-6">
      <div class={titulo} data-revelar>
        <p class={antetitulo}>Cómo trabajo</p>
        <h2 class={h2}>El proceso, paso a paso</h2>
      </div>
      <!-- Los pasos son puntos de una línea de perfil -->
      <div class="relative mx-auto mt-14 max-w-6xl">
        <div class="relative hidden h-[120px] md:block" aria-hidden="true" data-revelar>
          <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <rect x="0" y="38" width="1200" height="44" class="fill-arena/25" />
            <path d={`M0 ${pasosY[0] + 18} L200 ${pasosY[0]} L600 ${pasosY[1]} L1000 ${pasosY[2]} L1200 ${pasosY[2] - 12}`} fill="none" class="trazo stroke-cafe/70" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" style="--largo: 2600" data-dibujar />
          </svg>
          <div class="grid h-full grid-cols-3">
            {proceso.map((_, i) => (
              <div class="relative">
                <span class="absolute left-1/2 grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-cafe bg-crema font-serif text-lg text-cafe" style={`top: ${pasosY[i]}px`}>{i + 1}</span>
              </div>
            ))}
          </div>
        </div>
        <ol class="relative grid gap-10 border-l-2 border-cafe/25 pl-8 md:mt-6 md:grid-cols-3 md:gap-0 md:border-0 md:pl-0">
          {proceso.map((p, i) => (
            <li class="relative md:px-8 md:text-center" data-revelar>
              <span class="absolute top-0.5 -left-[2.6rem] grid size-8 place-items-center rounded-full border-2 border-cafe bg-crema font-serif text-sm text-cafe md:hidden" aria-hidden="true">{i + 1}</span>
              <h3 class="font-serif text-2xl text-tinta">{p.titulo}</h3>
              <p class="mt-3 leading-relaxed text-texto">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Cuándo consultar -->
      <div class="mx-auto mt-16 flex max-w-6xl flex-col items-center gap-6 rounded-[2rem] bg-tinta px-8 py-10 text-center text-white md:flex-row md:justify-between md:px-12 md:text-left" data-revelar>
        <div class="max-w-2xl">
          <h3 class="font-serif text-2xl sm:text-3xl">¿Cuándo consultar?</h3>
          <p class="mt-3 leading-relaxed text-white/80">
            Si sos mamá, papá o docente y venís notando dificultades en el aprendizaje, la atención o la organización, este puede ser el momento.{' '}
            <strong class="text-white">Consultar a tiempo es una forma de cuidado.</strong>
          </p>
        </div>
        <a href={enlaceWhatsapp || '#contacto'} target={enlaceWhatsapp ? '_blank' : undefined} rel="noopener" class="shrink-0 rounded-full bg-white px-7 py-3.5 font-semibold text-tinta transition hover:bg-crema">
          Escribime
        </a>
      </div>
    </section>

    <!-- Obras sociales -->
    <section id="obras-sociales" class="bg-crema-claro px-4 py-20 sm:px-6">
      <div class={titulo} data-revelar>
        <p class={antetitulo}>Coberturas</p>
        <h2 class={h2}>Obras sociales</h2>
        <p class="mt-4 text-lg text-texto">Trabajo con obras sociales, pacientes con CUD y de manera particular.</p>
      </div>
      <ul class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-4 md:grid-cols-4">
        {coberturas.map((c) => (
          <li class="flex flex-col items-center justify-center gap-4 rounded-3xl bg-white px-4 py-7 shadow-sm text-center ring-1 ring-cafe/10" data-revelar>
            {c.logo ? (
              <Image src={c.logo} alt={c.nombre} height={96} densities={[1, 2]} class="h-24 w-auto rounded-xl object-contain" />
            ) : (
              <span class="font-serif text-2xl font-semibold tracking-tight text-tinta sm:text-3xl">{c.nombre}</span>
            )}
            <span class={`rounded-full px-3 py-1 text-xs font-semibold ${c.modalidad === 'Prestadora' ? 'bg-cafe text-white' : 'bg-white text-cafe ring-1 ring-cafe/25'}`}>
              {c.modalidad}
            </span>
          </li>
        ))}
      </ul>
      <ul class="mx-auto mt-4 grid max-w-5xl gap-4 sm:grid-cols-2">
        {otrasCoberturas.map((c) => (
          <li class="flex items-center gap-4 rounded-3xl bg-tinta px-6 py-5 text-white" data-revelar>
            <span class="font-serif text-2xl">{c.nombre}</span>
            <span class="text-sm text-white/75">{c.detalle}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="bg-white px-4 py-24 sm:px-6">
      <div class={titulo} data-revelar>
        <p class={antetitulo}>Qué hago</p>
        <h2 class={h2}>Servicios</h2>
      </div>
      <div class="mx-auto mt-14 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {servicios.map((s) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-cafe/10 transition duration-300 hover:-translate-y-1 hover:shadow-xl" data-revelar>
            <div class="overflow-hidden">
              <Image src={s.foto} alt={s.titulo} width={600} class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-serif text-xl leading-snug text-tinta">{s.titulo}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-texto">{s.texto}</p>
            </div>
          </article>
        ))}
      </div>
      <ul class="mx-auto mt-8 flex max-w-6xl flex-wrap justify-center gap-3" data-revelar>
        {otrosServicios.map((s) => (
          <li class="rounded-full bg-white px-5 py-2.5 text-sm font-medium text-cafe ring-1 ring-cafe/15">{s}</li>
        ))}
      </ul>
    </section>

    <!-- Sobre mí: línea de tiempo -->
    <section id="sobre-mi" class="px-4 py-24 sm:px-6">
      <div class={titulo} data-revelar>
        <p class={antetitulo}>Trayectoria</p>
        <h2 class={h2}>Sobre mí</h2>
      </div>

      <ol class="relative mx-auto mt-16 max-w-5xl space-y-14 before:absolute before:top-2 before:bottom-2 before:left-4 before:w-px before:bg-cafe/20 md:space-y-20 md:before:left-1/2">
        {trayectoria.map((t, i) => (
          <li class="relative grid items-center gap-6 pl-12 md:grid-cols-2 md:gap-16 md:pl-0" data-revelar>
            <span class="absolute top-2 left-4 size-3 -translate-x-1/2 rounded-full bg-cafe ring-4 ring-crema md:top-1/2 md:left-1/2 md:-translate-y-1/2" aria-hidden="true"></span>
            <div class={i % 2 ? 'md:order-2' : ''}>
              {t.foto ? (
                <Image
                  src={t.foto}
                  alt={t.alt ?? t.titulo}
                  width={720}
                  class="aspect-[4/3] w-full rounded-3xl object-cover shadow-lg"
                  style={`object-position: ${t.posicion ?? 'center'}`}
                />
              ) : null}
            </div>
            <div class={`${i % 2 ? 'md:order-1 md:text-right' : ''} ${t.foto ? '' : 'rounded-3xl bg-white p-7 shadow-sm ring-1 ring-cafe/10'}`}>
              <span class="inline-block rounded-full bg-crema-claro px-3 py-1 text-xs font-semibold tracking-wide text-cafe ring-1 ring-cafe/15">
                {t.anio ?? t.etiqueta}
              </span>
              <h3 class="mt-3 font-serif text-2xl leading-snug text-tinta sm:text-3xl">{t.titulo}</h3>
              <p class="mt-3 leading-relaxed text-texto">{t.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Preguntas frecuentes -->
    <section id="preguntas" class="bg-crema-claro px-4 py-24 sm:px-6">
      <div class={titulo} data-revelar>
        <p class={antetitulo}>Preguntas frecuentes</p>
        <h2 class={h2}>Lo que más me consultan</h2>
      </div>
      <div class="mx-auto mt-12 max-w-3xl space-y-3">
        {preguntas.map((p) => (
          <details class="group rounded-2xl bg-white px-6 py-5 ring-1 ring-cafe/10 open:shadow-md" data-revelar>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-tinta sm:text-xl [&::-webkit-details-marker]:hidden">
              {p.pregunta}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-crema text-cafe transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-texto">{p.respuesta}</p>
          </details>
        ))}
      </div>
    </section>

    <Contacto />
  </main>

  <footer class="bg-tinta px-4 pt-14 pb-8 text-crema sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-10 text-center md:grid-cols-3 md:text-left">
      <div class="space-y-1.5 text-crema/70">
        <p class="font-serif text-xl text-white">{persona.nombre}</p>
        <p>Licenciada en Psicopedagogía</p>
        {persona.matriculas.map((m) => <p>Matrícula {m.provincia}: {m.numero}</p>)}
        <p>{persona.ubicacion}</p>
      </div>

      <div>
        <h4 class="mb-3 text-xs font-semibold tracking-widest text-arena uppercase">Enlaces</h4>
        <div class="flex flex-col gap-2">
          <a href="#evaluaciones" class={enlaceFooter}>Evaluaciones</a>
          <a href="#servicios" class={enlaceFooter}>Servicios</a>
          <a href="#obras-sociales" class={enlaceFooter}>Obras sociales</a>
          <a href="#preguntas" class={enlaceFooter}>Preguntas frecuentes</a>
          <a href={`mailto:${persona.email}`} class={enlaceFooter}>Consultas por email</a>
          {persona.telefono && <a href={enlaceWhatsapp} target="_blank" rel="noopener" class={enlaceFooter}>WhatsApp {persona.telefono}</a>}
        </div>
      </div>

      <div>
        <h4 class="mb-3 text-xs font-semibold tracking-widest text-arena uppercase">Seguime</h4>
        <div class="flex justify-center gap-3 md:justify-start">
          <a href={persona.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="grid size-11 place-items-center rounded-full bg-white/10 text-crema transition hover:bg-cafe">
            <Icono nombre="instagram" class="size-5" />
          </a>
          <a href={persona.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-11 place-items-center rounded-full bg-white/10 text-crema transition hover:bg-cafe">
            <Icono nombre="linkedin" class="size-5" />
          </a>
          {enlaceWhatsapp && (
            <a href={enlaceWhatsapp} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid size-11 place-items-center rounded-full bg-white/10 text-crema transition hover:bg-cafe">
              <Icono nombre="whatsapp" class="size-5" />
            </a>
          )}
        </div>
      </div>
    </div>
    <p class="mx-auto mt-12 max-w-6xl border-t border-white/10 pt-6 text-center text-sm text-crema/50">
      &copy; {anio} {persona.nombre}. Todos los derechos reservados.
    </p>
  </footer>

  {enlaceWhatsapp && (
    <a
      href={enlaceWhatsapp}
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
      class="fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-xl shadow-black/20 transition hover:scale-105 sm:right-6 sm:bottom-6"
    >
      <Icono nombre="whatsapp" class="size-7" />
    </a>
  )}
</Layout>
