---
import '../styles/global.css';
import { persona } from '../data/sitio';

const titulo = `${persona.nombre} · Psicopedagoga en ${persona.ubicacion.split(',')[0]}`;
const descripcion =
  'Psicopedagoga especializada en Derechos Humanos y Políticas Públicas de Niñez, Adolescencia y Familia. Evaluación neurocognitiva, diagnóstico y tratamiento psicopedagógico, talleres y consultoría.';
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased">
    <slot />

    <script>
      // Sin JS el contenido se ve igual: .revelar solo oculta cuando este script corre
      const observador = new IntersectionObserver(
        (entradas) =>
          entradas.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observador.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('[data-revelar]').forEach((el) => {
        el.classList.add('revelar');
        observador.observe(el);
      });
    </script>
  </body>
</html>
